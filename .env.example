# ===== MongoDB =====
# MongoDB 用户名（首次启动时创建的 root 账号）
MONGO_USERNAME=root
# MongoDB 密码（生产环境请务必修改）
MONGO_PASSWORD=rootpassword
# MongoDB 数据库名
MONGO_DATABASE=gardening

# ===== JWT =====
# JWT 签名密钥（生产环境请务必修改为随机字符串）
JWT_SECRET=your-super-secret-key-change-in-production
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ===== MinIO 对象存储 =====
# MinIO 访问密钥
MINIO_ACCESS_KEY=minioadmin
# MinIO 密钥（生产环境请务必修改）
MINIO_SECRET_KEY=minioadmin

# ===== 微信 OAuth2（可选，未配置则不启用微信登录） =====
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
